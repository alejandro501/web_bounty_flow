# syntax=docker/dockerfile:1.7
FROM golang:1.25-alpine AS build
WORKDIR /src

RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

RUN mkdir -p /toolbin
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOBIN=/toolbin go install github.com/alejandro501/generate_dork_links@latest && \
    GOBIN=/toolbin go install github.com/alejandro501/sort_http@latest && \
    GOBIN=/toolbin go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest && \
    GOBIN=/toolbin go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest && \
    GOBIN=/toolbin go install github.com/tomnomnom/httprobe@latest && \
    GOBIN=/toolbin go install github.com/tomnomnom/assetfinder@latest && \
    GOBIN=/toolbin go install github.com/owasp-amass/amass/v4/cmd/amass@master && \
    GOBIN=/toolbin go install github.com/projectdiscovery/dnsx/cmd/dnsx@latest && \
    GOBIN=/toolbin go install github.com/projectdiscovery/httpx/cmd/httpx@latest && \
    GOBIN=/toolbin go install github.com/lc/gau/v2/cmd/gau@latest && \
    GOBIN=/toolbin go install github.com/ffuf/ffuf@latest && \
    GOBIN=/toolbin go install github.com/assetnote/h2csmuggler/cmd/h2csmuggler@latest && \
    GOBIN=/toolbin go install github.com/tomnomnom/anew@latest && \
    GOBIN=/toolbin go install github.com/tomnomnom/waybackurls@latest
RUN wget -q -O /tmp/aquatone.zip https://github.com/michenriksen/aquatone/releases/download/v1.7.0/aquatone_linux_amd64_1.7.0.zip && \
    unzip -p /tmp/aquatone.zip aquatone > /toolbin/aquatone && \
    chmod +x /toolbin/aquatone && \
    rm -f /tmp/aquatone.zip

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o /bin/bflow-server ./cmd/server

FROM alpine:3.18
ARG APP_UID=1000
ARG APP_GID=1000
RUN addgroup -S -g "${APP_GID}" app && adduser -S -u "${APP_UID}" -G app app

WORKDIR /app
COPY --from=build /bin/bflow-server /usr/local/bin/bflow-server
COPY --from=build /usr/local/go /usr/local/go
COPY --from=build /toolbin/ /usr/local/bin/
COPY flow.yaml .
COPY scripts ./scripts
COPY package.json package-lock.json ./
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
RUN apk add --no-cache git curl unzip nmap python3 py3-pip su-exec bash nodejs npm chromium
RUN printf '%s\n' \
    '#!/bin/sh' \
    'exec /usr/bin/chromium --headless --no-sandbox --disable-setuid-sandbox --disable-dev-shm-usage --disable-gpu "$@"' \
    > /usr/local/bin/chromium-aquatone && \
    chmod +x /usr/local/bin/chromium-aquatone
RUN pip3 install --no-cache-dir sublist3r
RUN git clone --depth 1 https://github.com/offensive-security/exploitdb.git /opt/exploitdb && \
    ln -sf /opt/exploitdb/searchsploit /usr/local/bin/searchsploit
RUN npm install --omit=dev && \
    HOME=/home/app npx playwright install chromium && \
    mkdir -p data fuzzing robots dorking logs && \
    chown -R app:app /app

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bflow-server", "--config", "/app/flow.yaml"]
